{
  // Cloudflare deployment config. The site is plain static files: no server code runs.
  // `npx wrangler deploy` uploads everything in dist/ to Cloudflare's global network.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vaquero-rv-park-website",
  "compatibility_date": "2026-09-26",
  // the site answers only on vaquerorvpark.com, so search engines never see a duplicate copy
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist"
  }
}
